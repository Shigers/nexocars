# ==============================================================================
# NEXO-CAR CRM & ERP - ENVIRONMENT CONFIGURATION
# ==============================================================================

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Dealership Default Settings
NEXT_PUBLIC_DEFAULT_COMPANY_NAME="Orlando Cars"
NEXT_PUBLIC_DEFAULT_COMPANY_SLUG="orlando-cars"
NEXT_PUBLIC_APP_URL=http://localhost:3000

# AI Configuration (OpenAI)
OPENAI_API_KEY=sk-your-openai-api-key

# WhatsApp Business Cloud API (Meta)
WHATSAPP_API_TOKEN=your-meta-whatsapp-token
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_VERIFY_TOKEN=your-webhook-verify-token

# Multi-portal Distribution Webhook (n8n)
N8N_WEBHOOK_PORTALS_URL=https://n8n.yourdomain.com/webhook/dealcar-distributor
